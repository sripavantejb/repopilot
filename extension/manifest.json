{
  "manifest_version": 3,
  "name": "RepoPilot - GitHub AI Review & Context Side Panel",
  "version": "1.0.0",
  "description": "Automatically opens RepoPilot in the Chrome side panel when viewing GitHub repositories, PRs, and issues.",
  "permissions": [
    "sidePanel",
    "tabs",
    "storage",
    "declarativeNetRequest"
  ],
  "host_permissions": [
    "https://github.com/*",
    "https://*.vercel.app/*",
    "http://localhost:3000/*"
  ],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "ruleset_1",
        "enabled": true,
        "path": "rules.json"
      }
    ]
  },
  "background": {
    "service_worker": "service-worker.js"
  },
  "action": {
    "default_title": "Open RepoPilot Side Panel"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "devtools_page": "devtools.html",
  "content_scripts": [
    {
      "matches": [
        "https://github.com/*",
        "http://localhost:3000/*",
        "https://*.vercel.app/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "externally_connectable": {
    "matches": [
      "https://github.com/*",
      "http://localhost:3000/*",
      "https://*.vercel.app/*"
    ]
  },
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
